; Engine configuration file.
config_version=5

[application]

config/name="흥정왕 전당포"
config/description="전당포 흥정 시뮬레이션"
config/version="1.7.0"
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/icon/icon_192.png"

[autoload]

GameData="*res://scripts/core/game_data.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=1170
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Regular.otf"

[input_devices]

pointing/emulate_touch_from_mouse=true
